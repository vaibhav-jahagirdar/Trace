{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "commonjs",
    "target": "esnext",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
